{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LocalWORK",
  "version": "0.1.0",
  "identifier": "dev.localwork.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "LocalWORK", "width": 1280, "height": 820, "minWidth": 900, "minHeight": 600, "visible": true }
    ],
    "security": { "csp": null }
  },
  "bundle": { "active": false }
}
