{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LocalWORK",
  "version": "0.1.0",
  "identifier": "dev.localwork.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "LocalWORK", "width": 1280, "height": 820, "minWidth": 900, "minHeight": 600, "visible": true }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "LocalWORK",
    "shortDescription": "Local work-style AI desktop app",
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "resources": {
      "../vendor/aionrs.exe": "vendor/aionrs.exe",
      "../vendor/officecli.exe": "vendor/officecli.exe",
      "../vendor/manifest.json": "vendor/manifest.json",
      "../vendor/node/": "vendor/node/",
      "../vendor/playwright/": "vendor/playwright/",
      "../vendor/browsers/": "vendor/browsers/",
      "../vendor/whisper/": "vendor/whisper/",
      "../workbench-mcp/libs/": "workbench-mcp/libs/",
      "../workbench-mcp/*.py": "workbench-mcp/",
      "../skills/": "skills/"
    },
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "startMenuFolder": "LocalWORK",
        "installerHooks": "installer/hooks.nsh",
        "displayLanguageSelector": false,
        "compression": "lzma"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENERjRBRDgxOUE0Mjk4MjIKUldRaW1FS2FnYTMwelkzeWhwVmdwVEdsNXVrb054L3dSZjZ5UlJZdzBJeDUwNEJvRk5salZuelIK",
      "endpoints": ["https://github.com/killianmiles27/LocalWORK/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
