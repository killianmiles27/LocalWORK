+}
+#[tokio::test]
+async fn unfinished_plan_cannot_be_reported_as_success_and_does_not_force_later_unrelated_work() {
+    let (mut engine, p) = engine(
+        vec![
+            plan("plan-1", "doing"),
+            answer("Files pending"),
+            answer("Files still pending"),
+            answer("The requested explanation"),
