+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+enum ExecutionStage {
+    Analysis,
+    Execution,
+    Verification,
+}
+
+impl Default for ExecutionStage {
+    fn default() -> Self {
+        Self::Analysis
+    }
+}
+
+impl ExecutionStage {
+    fn parse(value: &str) -> Option<Self> {
+        match value {
+            "analysis" => Some(Self::Analysis),
+            "execution" => Some(Self::Execution),
+            "verification" => Some(Self::Verification),
+            _ => None,
+        }
+    }
+}
