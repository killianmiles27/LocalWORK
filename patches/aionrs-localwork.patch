@@ -0,0 +1,240 @@
+use super::*;
+use aion_types::llm::LlmEvent;
+use aion_types::message::{StopReason, TokenUsage};
+use std::sync::Mutex;
+use tokio::sync::mpsc;
+struct Provider {
+    prompts: Mutex<Vec<String>>,
+    truncate: bool,
+    reject_large: bool,
+    exact_tokens: Option<u64>,
+    pending: bool,
+    drop_request: bool,
+}
+#[async_trait::async_trait]
+impl LlmProvider for Provider {
+    async fn compact(
+        &self,
+        req: &NativeCompactRequest,
+    ) -> Result<Option<aion_types::compact::NativeCompactResult>, ProviderError> {
+        let tokens = self
+            .exact_tokens
+            .unwrap_or_else(|| estimate_messages_tokens(&req.messages));
+        let mut messages = req.messages.clone();
+        if self.drop_request {
+            messages.remove(0);
+        }
+
+        Ok(Some(aion_types::compact::NativeCompactResult {
+            messages,
+            compacted: false,
+            before_tokens: tokens,
+            after_tokens: tokens,
+            messages_summarized: 0,
+        }))
+    }
+    async fn stream(&self, req: &LlmRequest) -> Result<mpsc::Receiver<LlmEvent>, ProviderError> {
+        if self.pending {
+            return std::future::pending().await;
+        }
+        assert!(req.tools.is_empty());
+        assert!(matches!(req.thinking, Some(ThinkingConfig::Disabled)));
+        let text = serde_json::to_string(&req.messages).unwrap();
+        if self.reject_large && text.len() > 18000 {
+            return Err(ProviderError::PromptTooLong("test budget".into()));
+        }
+        self.prompts.lock().unwrap().push(text);
+        let (tx, rx) = mpsc::channel(2);
+        tx.send(LlmEvent::TextDelta(
+            "Verified workbook data; report still pending. Keep the source paths and original categories.".into(),
+        ))
+        .await
+        .unwrap();
+        tx.send(LlmEvent::Done {
+            stop_reason: if self.truncate {
+                StopReason::MaxTokens
+            } else {
+                StopReason::EndTurn
+            },
+            usage: TokenUsage::default(),
+        })
+        .await
+        .unwrap();
+        Ok(rx)
+    }
+}
+fn history() -> Vec<Message> {
+    let mut messages = vec![
+        Message::new(
+            Role::System,
+            vec![ContentBlock::Text {
+                text: "Preserve all files".into(),
+            }],
+        ),
+        Message::new(
+            Role::User,
+            vec![ContentBlock::Text {
+                text: "Make a yearly summary and one-page report".into(),
+            }],
+        ),
+    ];
+    for n in 0..6 {
+        messages.push(Message::new(
+            Role::Assistant,
+            vec![ContentBlock::ToolUse {
+                id: format!("call-{n}"),
+                name: "read".into(),
+                input: serde_json::json!({"path":"source.xlsx"}),
+                extra: None,
+            }],
+        ));
+        messages.push(Message::new(
+            Role::User,
+            vec![ContentBlock::ToolResult {
+                tool_use_id: format!("call-{n}"),
+                content: format!("fragment-{n}-{}-end-{n}", "\u{03b1}data ".repeat(3000)),
+                is_error: false,
+            }],
+        ));
+    }
+    messages
+}
+fn provider(truncate: bool) -> Provider {
+    Provider {
+        prompts: Mutex::new(vec![]),
+        truncate,
+        reject_large: false,
+        exact_tokens: None,
+        pending: false,
+        drop_request: false,
+    }
+}
+fn config() -> CompactConfig {
+    CompactConfig {
+        context_window: 32000,
+        output_reserve: 2000,
+        ..Default::default()
+    }
+}
+#[tokio::test]
+async fn first_turn_checkpoint_keeps_request_and_complete_recent_groups() {
+    let original = history();
+    let before = serde_json::to_value(&original).unwrap();
+    let p = provider(false);
+    let result = within_turn(&p, &original, "test", &config(), 100)
+        .await
+        .unwrap()
+        .unwrap();
+    assert!(result.compacted);
+    assert!(!result.native);
+    assert_eq!(
+        serde_json::to_value(&result.messages[..2]).unwrap(),
+        serde_json::to_value(&original[..2]).unwrap()
+    );
+    assert_eq!(
+        serde_json::to_value(&result.messages[result.messages.len() - 4..]).unwrap(),
+        serde_json::to_value(&original[original.len() - 4..]).unwrap()
+    );
+    assert_eq!(serde_json::to_value(&original).unwrap(), before);
+    let prompts = p.prompts.lock().unwrap().join("\n");
+    for n in 0..4 {
+        assert!(prompts.contains(&format!("fragment-{n}")));
+        assert!(prompts.contains(&format!("end-{n}")));
+    }
+    assert!(result.after_tokens.unwrap() < result.pre_compact_tokens);
+}
+#[tokio::test]
+async fn checkpoint_keeps_intervening_user_corrections_exact() {
+    let mut messages = history();
+    messages.insert(
+        6,
+        Message::new(
+            Role::User,
+            vec![ContentBlock::Text {
+                text: "Do not overwrite the source. Use euros.".into(),
+            }],
+        ),
+    );
+    let p = provider(false);
+    let result = within_turn(&p, &messages, "test", &config(), 0).await.unwrap().unwrap();
+    assert!(
+        result
+            .messages
+            .iter()
+            .any(|m| serde_json::to_value(m).unwrap() == serde_json::to_value(&messages[6]).unwrap())
+    );
+}
+#[tokio::test]
+async fn truncated_checkpoint_keeps_original() {
+    let messages = history();
+    let original = serde_json::to_value(&messages).unwrap();
+    assert!(matches!(
+        within_turn(&provider(true), &messages, "test", &config(), 0).await,
+        Err(CompactError::TruncatedResponse)
+    ));
+    assert_eq!(serde_json::to_value(messages).unwrap(), original);
+}
+#[tokio::test]
+async fn retry_shrinks_fragment_without_dropping_data() {
+    let mut p = provider(false);
+    p.reject_large = true;
+    let messages = history();
+    let result = within_turn(&p, &messages, "test", &config(), 0).await.unwrap().unwrap();
+    assert!(result.compacted);
+    let prompts = p.prompts.lock().unwrap().join("\n");
+    for n in 0..4 {
+        assert!(prompts.contains(&format!("fragment-{n}")));
+        assert!(prompts.contains(&format!("end-{n}")));
+    }
+}
+#[tokio::test]
+async fn unresolved_tool_call_is_never_checkpointed() {
+    let mut messages = history();
+    messages.pop();
+    assert!(
+        within_turn(&provider(false), &messages, "test", &config(), 0)
+            .await
+            .is_err()
+    );
+}
+
+#[tokio::test]
+async fn exact_token_validation_rejects_dense_tail_and_preserves_original() {
+    let messages = history();
+    let original = serde_json::to_value(&messages).unwrap();
+    let mut p = provider(false);
+    p.exact_tokens = Some(31900);
+    assert!(within_turn(&p, &messages, "test", &config(), 100).await.is_err());
+    assert_eq!(serde_json::to_value(&messages).unwrap(), original);
+}
+#[tokio::test]
+async fn emergency_reserve_is_checked_before_acceptance() {
+    let mut cfg = config();
+    cfg.emergency_buffer = 8000;
+    let mut p = provider(false);
+    p.exact_tokens = Some(25000);
+    assert!(within_turn(&p, &history(), "test", &cfg, 0).await.is_err());
+}
+#[tokio::test]
+async fn cancellation_during_checkpoint_keeps_original() {
+    let messages = history();
+    let original = serde_json::to_value(&messages).unwrap();
+    let mut p = provider(false);
+    p.pending = true;
+    assert!(
+        tokio::time::timeout(
+            std::time::Duration::from_millis(10),
+            within_turn(&p, &messages, "test", &config(), 0)
+        )
+        .await
+        .is_err()
+    );
+    assert_eq!(serde_json::to_value(&messages).unwrap(), original);
+}
+#[tokio::test]
+async fn native_revalidation_cannot_remove_protected_requests() {
+    let messages = history();
+    let mut p = provider(false);
+    p.drop_request = true;
+    assert!(within_turn(&p, &messages, "test", &config(), 0).await.is_err());
+}
diff --git a/crates/aion-agent/tests/generation_recovery_test.rs b/crates/aion-agent/tests/generation_recovery_test.rs
new file mode 100644
index 0000000..d6f2fe9
--- /dev/null
+++ b/crates/aion-agent/tests/generation_recovery_test.rs
@@ -0,0 +1,403 @@
+mod common;
+use aion_agent::engine::AgentEngine;
+use aion_agent::output::OutputSink;
+use aion_providers::{LlmProvider, ProviderError};
+use aion_tools::registry::ToolRegistry;
+use aion_types::llm::{LlmEvent, LlmRequest, ThinkingConfig};
+use aion_types::message::{ContentBlock, StopReason, TokenUsage};
+use async_trait::async_trait;
+use common::{MockTool, test_config};
+use serde_json::json;
+use std::collections::VecDeque;
+use std::sync::{Arc, Mutex};
+use tokio::sync::mpsc;
+struct Provider {
+    turns: Mutex<VecDeque<Vec<LlmEvent>>>,
+    requests: Mutex<Vec<LlmRequest>>,
+    infos: Arc<Mutex<Vec<String>>>,
+    native: bool,
+}
+
+struct RecordingSink(Arc<Mutex<Vec<String>>>);
+impl OutputSink for RecordingSink {
+    fn emit_text_delta(&self, _: &str, _: &str) {}
+    fn emit_thinking(&self, _: &str, _: &str) {}
+    fn emit_tool_call(&self, _: &str, _: &str, _: &str) {}
+    fn emit_tool_result(&self, _: &str, _: &str, _: bool, _: &str) {}
+    fn emit_stream_start(&self, _: &str) {}
+    fn emit_stream_end(&self, _: &str, _: usize, _: u64, _: u64, _: u64, _: u64) {}
+    fn emit_error(&self, _: &str) {}
+    fn emit_info(&self, message: &str) { self.0.lock().unwrap().push(message.to_string()); }
+}
+#[async_trait]
+impl LlmProvider for Provider {
+    fn native_compaction_enabled(&self) -> bool {
+        self.native
+    }
+    async fn stream(&self, request: &LlmRequest) -> Result<mpsc::Receiver<LlmEvent>, ProviderError> {
+        self.requests.lock().unwrap().push(request.clone());
+        let events = self
+            .turns
+            .lock()
+            .unwrap()
+            .pop_front()
+            .ok_or_else(|| ProviderError::Parse("unexpected extra generation".into()))?;
+        let (tx, rx) = mpsc::channel(events.len() + 1);
+        for event in events {
+            tx.send(event).await.unwrap();
+        }
+        Ok(rx)
+    }
+}
+fn done(reason: StopReason) -> LlmEvent {
+    LlmEvent::Done {
+        stop_reason: reason,
+        usage: TokenUsage::default(),
+    }
+}
+fn answer(text: &str) -> Vec<LlmEvent> {
+    vec![LlmEvent::TextDelta(text.into()), done(StopReason::EndTurn)]
+}
+fn plan(id: &str, status: &str) -> Vec<LlmEvent> {
+    plan_stage(id, status, None)
+}
+fn plan_stage(id: &str, status: &str, stage: Option<&str>) -> Vec<LlmEvent> {
+    let mut input = json!({"steps":[{"text":"Create and verify requested files","status":status}]});
+    if let Some(stage) = stage {
+        input["stage"] = json!(stage);
+    }
+    vec![
+        LlmEvent::ToolUse {
+            id: id.into(),
+            name: "update_plan".into(),
+            input,
+            extra: None,
+        },
+        done(StopReason::ToolUse),
+    ]
+}
+fn engine(turns: Vec<Vec<LlmEvent>>, native: bool) -> (AgentEngine, Arc<Provider>) {
+    engine_with_write_error(turns, native, false)
+}
+fn engine_with_write_error(
+    turns: Vec<Vec<LlmEvent>>,
+    native: bool,
+    write_error: bool,
+) -> (AgentEngine, Arc<Provider>) {
+    let infos = Arc::new(Mutex::new(Vec::new()));
+    let provider = Arc::new(Provider {
+        turns: Mutex::new(turns.into()),
+        requests: Mutex::new(vec![]),
+        infos: Arc::clone(&infos),
+        native,
+    });
+    let mut config = test_config();
+    config.thinking = Some(ThinkingConfig::Enabled { budget_tokens: 4321 });
+    config.max_turns = Some(20);
+    config.session.enabled = false;
+    config.compact.enabled = false;
+    let mut tools = ToolRegistry::new();
+    tools.register(Box::new(MockTool::new("update_plan", "Shown to user", false)));
+    tools.register(Box::new(MockTool::new("write_file", "Created and verified", write_error)));
+    let mut engine = AgentEngine::new_with_provider(
+            provider.clone(),
+            config,
+            tools,
+            Arc::new(RecordingSink(infos)),
+            std::env::temp_dir(),
+        );
+    engine.set_initial_reasoning_effort(Some("high".into()));
+    (engine, provider)
+}
+
+fn work(id: &str) -> Vec<LlmEvent> {
+    vec![
+        LlmEvent::ToolUse {
+            id: id.into(),
+            name: "write_file".into(),
+            input: json!({}),
+            extra: None,
+        },
+        done(StopReason::ToolUse),
+    ]
+}
+
+fn request_metrics(infos: &[String]) -> Vec<serde_json::Value> {
+    infos
+        .iter()
+        .filter_map(|info| info.strip_prefix("Request metrics: "))
+        .map(|json| serde_json::from_str(json).unwrap())
+        .collect()
+}
+
+#[tokio::test]
+async fn execution_stage_lowers_effort_and_keeps_thinking_then_verification_restores_effort() {
+    let (mut engine, provider) = engine(
+        vec![
+            plan_stage("p1", "doing", Some("execution")),
+            work("write-1"),
+            plan_stage("p2", "done", Some("verification")),
+            answer("Files are complete"),
+        ],
+        true,
+    );
+
+    engine.run("Create files", "stage-test").await.unwrap();
+    let requests = provider.requests.lock().unwrap();
+    assert_eq!(requests.len(), 4);
+    assert_eq!(requests[0].reasoning_effort.as_deref(), Some("high"));
+    assert_eq!(requests[1].reasoning_effort.as_deref(), Some("low"));
+    assert!(matches!(requests[1].thinking, Some(ThinkingConfig::Enabled { budget_tokens: 4321 })));
+    assert_eq!(requests[2].reasoning_effort.as_deref(), Some("low"));
+    assert_eq!(requests[3].reasoning_effort.as_deref(), Some("high"));
+    assert!(matches!(requests[3].thinking, Some(ThinkingConfig::Enabled { budget_tokens: 4321 })));
+    drop(requests);
+    let metrics = request_metrics(&provider.infos.lock().unwrap());
+    assert_eq!(metrics.len(), 4);
+    for metric in metrics {
+        assert_eq!(metric["phase"], "normal");
+        assert!(metric["compaction_ms"].as_u64().is_some());
+        assert!(metric["request_wall_ms"].as_u64().is_some());
+        if let Some(first_event_ms) = metric["first_event_ms"].as_u64() {
+            assert!(first_event_ms <= metric["request_wall_ms"].as_u64().unwrap());
+        }
+        assert!(metric.get("messages").is_none());
+        assert!(metric.get("error").is_none());
+    }
+}
+
+#[tokio::test]
+async fn missing_or_unknown_stage_resets_to_default_after_successful_plan_update() {
+    for stage in [None, Some("unrecognized")] {
+        let (mut engine, provider) = engine(
+            vec![
+                plan_stage("p1", "doing", Some("execution")),
+                plan_stage("p2", "done", stage),
+                answer("Files are complete"),
+            ],
+            true,
+        );
+        engine.run("Create files", "stage-reset").await.unwrap();
+        let requests = provider.requests.lock().unwrap();
+        assert_eq!(requests[1].reasoning_effort.as_deref(), Some("low"));
+        assert_eq!(requests[2].reasoning_effort.as_deref(), Some("high"));
+    }
+}
+
+#[tokio::test]
+async fn tool_error_resets_execution_stage_and_new_run_starts_at_default() {
+    let (mut engine, provider) = engine_with_write_error(
+        vec![
+            plan_stage("p1", "done", Some("execution")),
+            work("write-fails"),
+            answer("The plan is complete"),
+            answer("Second request"),
+        ],
+        true,
+        true,
+    );
+    engine.run("First task", "first").await.unwrap();
+    engine.run("Second task", "second").await.unwrap();
+    let requests = provider.requests.lock().unwrap();
+    assert_eq!(requests[1].reasoning_effort.as_deref(), Some("low"));
+    assert_eq!(requests[2].reasoning_effort.as_deref(), Some("high"));
+    assert_eq!(requests[3].reasoning_effort.as_deref(), Some("high"));
+}
+
+#[tokio::test]
+async fn provider_stream_error_emits_failure_metrics_and_propagates() {
+    let (mut engine, provider) = engine(
+        vec![vec![LlmEvent::Error("provider failed".into())]],
+        true,
+    );
+
+    let result = engine.run("Create files", "provider-error").await;
+
+    assert!(result.is_err());
+    assert_eq!(provider.requests.lock().unwrap().len(), 1);
+    let metrics = request_metrics(&provider.infos.lock().unwrap());
+    assert_eq!(metrics.len(), 1);
+    assert_eq!(metrics[0]["phase"], "normal");
+    assert_eq!(metrics[0]["outcome"], "error");
+    assert!(metrics[0].get("error").is_none());
+}
+
+#[tokio::test]
+async fn provider_timing_event_is_emitted_separately_without_entering_history() {
+    let timings = json!({"prompt_n": 10, "prompt_ms": 2.5, "predicted_n": 3});
+    let (mut engine, provider) = engine(
+        vec![
+            vec![LlmEvent::RequestTiming(timings.clone()), LlmEvent::TextDelta("ok".into()), done(StopReason::EndTurn)],
+        ],
+        true,
+    );
+    engine.run("A short task", "timing").await.unwrap();
+
+    let metrics = request_metrics(&provider.infos.lock().unwrap());
+    let provider_timing = metrics.iter().find(|metric| metric["phase"] == "provider_timing").unwrap();
+    assert_eq!(provider_timing["timings"], timings);
+    let request_messages = serde_json::to_string(&provider.requests.lock().unwrap()[0].messages).unwrap();
+    assert!(!request_messages.contains("prompt_ms"));
+    assert!(!request_messages.contains("provider_timing"));
+}
+#[tokio::test]
+async fn repeated_reasoning_is_interrupted_then_executes_tool_with_tools_enabled() {
+    let repeated = "Repeat the same proposed batch without taking action. ".repeat(250);
+    let (mut engine, p) = engine(
+        vec![
+            vec![LlmEvent::ThinkingDelta(repeated.clone()), done(StopReason::EndTurn)],
+            vec![
+                LlmEvent::ToolUse {
+                    id: "write-1".into(),
+                    name: "write_file".into(),
+                    input: json!({}),
+                    extra: None,
+                },
+                done(StopReason::ToolUse),
+            ],
+            answer("Files created and verified"),
+        ],
+        true,
+    );
+    let result = engine.run("Create the requested files", "test").await.unwrap();
+    assert_eq!(result.text, "Files created and verified");
+    assert_eq!(result.turns, 3);
+    let reqs = p.requests.lock().unwrap();
+    assert!(!reqs[1].tools.is_empty());
+    assert!(matches!(reqs[1].thinking, Some(ThinkingConfig::Disabled)));
+    assert!(!serde_json::to_string(&reqs[1].messages).unwrap().contains(&repeated));
+    assert!(
+        reqs[2]
+            .messages
+            .iter()
+            .flat_map(|m| &m.content)
+            .any(|b| matches!(b,ContentBlock::ToolResult{tool_use_id,is_error:false,..} if tool_use_id=="write-1"))
+    );
+}
+#[tokio::test]
+async fn repeated_output_limits_stop_after_two_recoveries_without_forced_final_answer() {
+    let (mut engine, p) = engine(
+        (0..3)
+            .map(|_| {
+                vec![
+                    LlmEvent::ThinkingDelta("Still planning".into()),
+                    done(StopReason::MaxTokens),
+                ]
+            })
+            .collect(),
+        false,
+    );
+    let result = engine.run("Create files", "test").await.unwrap();
+    assert_eq!(result.stop_reason, StopReason::MaxTokens);
