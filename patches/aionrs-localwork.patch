+            &self,
+            req: &aion_types::compact::NativeCompactRequest,
+        ) -> Result<Option<aion_types::compact::NativeCompactResult>, ProviderError> {
+            self.requests.lock().unwrap().push(req.clone());
+            if self.pending {
+                return std::future::pending().await;
+            }
+            if self.fail {
+                return Err(ProviderError::Parse("truncated native checkpoint".into()));
+            }
+            let mut messages = req.messages.clone();
+            if self.compacted {
+                messages.remove(0);
+            }
+            Ok(Some(aion_types::compact::NativeCompactResult {
+                messages,
+                compacted: self.compacted,
+                before_tokens: 8000,
+                after_tokens: self.after_tokens,
+                messages_summarized: usize::from(self.compacted),
+            }))
+        }
+    }
