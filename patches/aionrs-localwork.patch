+mod execution_stage_tests {
+    use crate::engine::ExecutionStage;
+
+    #[test]
+    fn stage_hints_accept_only_known_values_and_default_to_analysis() {
+        assert_eq!(ExecutionStage::default(), ExecutionStage::Analysis);
+        assert_eq!(ExecutionStage::parse("execution"), Some(ExecutionStage::Execution));
+        assert_eq!(
+            ExecutionStage::parse("verification"),
+            Some(ExecutionStage::Verification)
+        );
+        assert_eq!(ExecutionStage::parse("analysis"), Some(ExecutionStage::Analysis));
+        assert_eq!(ExecutionStage::parse("unknown"), None);
+    }
+
+    #[test]
+    fn request_metrics_payload_has_safe_timing_and_usage_fields() {
+        let usage = aion_types::message::TokenUsage {
+            input_tokens: 123,
+            output_tokens: 45,
+            cache_read_tokens: 67,
+            ..Default::default()
+        };
+        let value = crate::engine::AgentEngine::request_metrics_value(
+            crate::turn::TurnKind::Normal,
+            Some("low"),
+            4,
+            20,
+            Some(7),
+            Some(&usage),
+            false,
+        );
+
+        assert_eq!(value["phase"], "normal");
+        assert_eq!(value["effective_reasoning_effort"], "low");
+        assert_eq!(value["compaction_ms"], 4);
+        assert_eq!(value["request_wall_ms"], 20);
+        assert_eq!(value["first_event_ms"], 7);
+        assert_eq!(value["input_tokens"], 123);
+        assert_eq!(value["output_tokens"], 45);
+        assert_eq!(value["cache_read_tokens"], 67);
+        assert!(value.get("error").is_none());
+        assert!(value["first_event_ms"].as_u64().unwrap() <= value["request_wall_ms"].as_u64().unwrap());
+        assert_eq!(
+            value.as_object().unwrap().keys().map(String::as_str).collect::<std::collections::BTreeSet<_>>(),
