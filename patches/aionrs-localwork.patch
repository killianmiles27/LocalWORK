+    if let Some(timings) = json.get("timings").and_then(parse_request_timings) {
+        events.push(LlmEvent::RequestTiming(timings));
+    }
+
     // Some gateways deliver terminal errors as a data frame in a 200-status
     // stream (`data: {"error": ...}`). Record the error so the stream
     // processor fails the stream instead of producing an empty outcome.
@@ -264,6 +276,30 @@ pub(crate) fn parse_sse_chunk(data: &str, state: &mut StreamState, auto_tool_id:
     events
 }
 
+fn parse_request_timings(value: &Value) -> Option<Value> {
+    const FIELDS: [&str; 6] = [
+        "prompt_n",
+        "prompt_ms",
+        "predicted_n",
+        "predicted_ms",
+        "predicted_per_second",
+        "cache_n",
+    ];
+    let mut timings = serde_json::Map::new();
+    for field in FIELDS {
+        let Some(number) = value.get(field) else {
+            continue;
+        };
+        if number
+            .as_f64()
+            .is_some_and(|number| number.is_finite() && number >= 0.0)
+        {
+            timings.insert(field.to_string(), number.clone());
+        }
+    }
+    (!timings.is_empty()).then_some(Value::Object(timings))
+}
+
