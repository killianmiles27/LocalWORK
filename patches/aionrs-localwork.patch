+        fn native_compaction_enabled(&self) -> bool {
+            true
+        }
+        async fn stream(&self, _: &LlmRequest) -> Result<mpsc::Receiver<LlmEvent>, ProviderError> {
+            panic!("native compaction must not fall back to a stream")
+        }
+        async fn compact(&self, request: &NativeCompactRequest) -> Result<Option<NativeCompactResult>, ProviderError> {
+            self.requests.lock().unwrap().push(request.clone());
+            if self.pending {
+                return std::future::pending().await;
+            }
+            if self.fail {
+                return Err(ProviderError::Parse("invalid native result".into()));
+            }
+            let mut messages = request.messages.clone();
+            if self.compacted {
+                messages.remove(0);
+            }
+            Ok(Some(NativeCompactResult {
+                messages,
+                compacted: self.compacted,
+                before_tokens: 1000,
+                after_tokens: if self.compacted { 400 } else { 1000 },
+                messages_summarized: usize::from(self.compacted),
+            }))
+        }
+    }
