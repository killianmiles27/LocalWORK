+        async fn stream(&self, req: &LlmRequest) -> Result<mpsc::Receiver<LlmEvent>, ProviderError> {
+            self.requests.lock().unwrap().push(req.clone());
+            let checkpoint = req.system.starts_with("Create a factual continuation checkpoint");
+            let (tx, rx) = mpsc::channel(2);
+            tx.send(LlmEvent::TextDelta(
+                if checkpoint {
