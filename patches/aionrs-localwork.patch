+
+#[tokio::test]
+async fn successful_tool_rounds_nudge_stale_plan_without_marking_it_done() {
+    let work = |n| {
+        vec![
+            LlmEvent::ToolUse {
+                id: format!("work-{n}"),
+                name: "write_file".into(),
