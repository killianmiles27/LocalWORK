+        async fn compact(
+            &self,
+            req: &aion_types::compact::NativeCompactRequest,
+        ) -> Result<Option<aion_types::compact::NativeCompactResult>, ProviderError> {
+            let tokens = crate::context_usage::estimate_messages_tokens(&req.messages);
+            Ok(Some(aion_types::compact::NativeCompactResult {
