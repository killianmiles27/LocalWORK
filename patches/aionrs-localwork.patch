+use super::*;
+use crate::openai::OpenAIProvider;
+use crate::provider::LlmProvider;
+use wiremock::matchers::{header, method, path};
+use wiremock::{Mock, MockServer, ResponseTemplate};
+
+fn message(role: Role, text: &str) -> Message {
+    Message::new(role, vec![ContentBlock::Text { text: text.into() }])
+}
+
+fn request() -> NativeCompactRequest {
+    NativeCompactRequest {
+        model: "local".into(),
+        output_reserve: 8192,
+        messages: vec![
+            message(Role::System, "immutable"),
+            message(Role::User, "old"),
+            message(Role::Assistant, "old answer"),
+            message(Role::User, "recent"),
+            message(Role::Assistant, "recent answer"),
+        ],
+    }
+}
+
+fn compat() -> ProviderCompat {
+    let mut compat = ProviderCompat::openai_defaults();
+    compat.transport.native_compaction_path = Some("/chat/compact".into());
+    compat.messages.merge_assistant_messages = Some(false);
+    compat.messages.clean_orphan_tool_results = Some(false);
+    compat.tools.clean_orphan_tool_calls = Some(false);
+    compat
+}
+
+fn response(request: &NativeCompactRequest) -> Value {
+    let (wire, _) = project_history(&request.messages, &compat());
+    json!({"messages":[wire[0], {"role":"user","content":"Historical summary: old"},
+        wire[wire.len()-2], wire[wire.len()-1]], "compacted":true,
+        "before_tokens":1000,"after_tokens":100,"retained_recent_count":2,"summary":"old"})
+}
+
+#[tokio::test]
+async fn posts_authenticated_native_path_and_restores_metadata() {
+    let server = MockServer::start().await;
+    let mut req = request();
+    req.messages[3].turn_id = Some("original-turn".into());
+    Mock::given(method("POST"))
+        .and(path("/v1/chat/compact"))
+        .and(header("authorization", "Bearer local-key"))
+        .respond_with(ResponseTemplate::new(200).set_body_json(response(&req)))
+        .expect(1)
+        .mount(&server)
+        .await;
+    let provider = OpenAIProvider::new("local-key", &format!("{}/v1/", server.uri()), compat());
+    assert!(provider.native_compaction_enabled());
+    let result = provider.compact(&req).await.unwrap().unwrap();
+    assert!(result.compacted);
+    assert_eq!(result.messages_summarized, 2);
+    assert_eq!(result.messages[2].turn_id.as_deref(), Some("original-turn"));
+    assert_eq!(result.messages[1].role, Role::User);
+}
+
+#[tokio::test]
+async fn opt_in_and_http_failure_do_not_fall_back() {
+    let server = MockServer::start().await;
+    let disabled = OpenAIProvider::new("k", &server.uri(), ProviderCompat::openai_defaults());
+    assert!(!disabled.native_compaction_enabled());
+    assert!(disabled.compact(&request()).await.unwrap().is_none());
+    Mock::given(method("POST"))
+        .respond_with(ResponseTemplate::new(500))
+        .mount(&server)
+        .await;
+    let enabled = OpenAIProvider::new("k", &server.uri(), compat());
+    assert!(matches!(
+        enabled.compact(&request()).await,
+        Err(ProviderError::Api { status: 500, .. })
+    ));
+}
+
+#[tokio::test]
+async fn unchanged_history_and_cancellation_are_safe() {
+    let server = MockServer::start().await;
+    let req = request();
+    let (wire, _) = project_history(&req.messages, &compat());
+    Mock::given(method("POST"))
+        .respond_with(ResponseTemplate::new(200).set_body_json(json!({
+        "messages":wire,"compacted":false,"before_tokens":10,"after_tokens":10,
+        "retained_recent_count":wire.len(),"summary":null})))
+        .mount(&server)
+        .await;
+    let provider = OpenAIProvider::new("k", &server.uri(), compat());
+    let result = provider.compact(&req).await.unwrap().unwrap();
+    assert!(!result.compacted);
+    assert_eq!(
+        serde_json::to_value(result.messages).unwrap(),
+        serde_json::to_value(&req.messages).unwrap()
+    );
+    server.reset().await;
+    Mock::given(method("POST"))
+        .respond_with(ResponseTemplate::new(200).set_delay(Duration::from_secs(2)))
+        .mount(&server)
+        .await;
+    assert!(
+        tokio::time::timeout(Duration::from_millis(50), provider.compact(&req))
+            .await
+            .is_err()
+    );
+    assert_eq!(req.messages.len(), 5);
+}
+
+#[test]
+fn rejects_system_injection_expansion_and_malformed_suffix() {
+    let req = request();
+    let (wire, boundaries) = project_history(&req.messages, &compat());
+    for mutation in ["system", "tokens", "suffix", "shape"] {
+        let mut body = response(&req);
+        match mutation {
+            "system" => body["messages"][1]["role"] = json!("system"),
+            "tokens" => body["after_tokens"] = json!(1001),
+            "suffix" => body["messages"][3]["content"] = json!("changed"),
+            _ => body["messages"][1]["tool_calls"] = json!([]),
+        }
+        assert!(
+            validate_result(&req, &wire, &boundaries, serde_json::from_value(body).unwrap()).is_err(),
+            "{mutation}"
+        );
+    }
+}
+
+#[test]
+fn retains_tool_result_group_with_original_error_and_turn_metadata() {
+    let mut req = request();
+    req.messages.truncate(3);
+    req.messages.push(message(Role::User, "recent"));
+    req.messages.push(Message::new(
+        Role::Assistant,
+        vec![
+            ContentBlock::ToolUse {
+                id: "a".into(),
+                name: "read".into(),
+                input: json!({}),
+                extra: None,
+            },
+            ContentBlock::ToolUse {
+                id: "b".into(),
+                name: "read".into(),
+                input: json!({}),
+                extra: None,
+            },
+        ],
+    ));
+    let mut results = Message::new(
+        Role::User,
+        vec![
+            ContentBlock::ToolResult {
+                tool_use_id: "a".into(),
+                content: "failed".into(),
+                is_error: true,
+            },
+            ContentBlock::ToolResult {
+                tool_use_id: "b".into(),
+                content: "ok".into(),
+                is_error: false,
+            },
+        ],
+    );
+    results.turn_id = Some("tool-turn".into());
+    req.messages.push(results);
+    validate_history(&req.messages).unwrap();
+    let (wire, boundaries) = project_history(&req.messages, &compat());
+    let body = json!({"messages":[wire[0],{"role":"user","content":"old"},wire[3],wire[4],wire[5],wire[6]],
+        "compacted":true,"before_tokens":100,"after_tokens":10,"retained_recent_count":4,"summary":"old"});
+    let result = validate_result(&req, &wire, &boundaries, serde_json::from_value(body).unwrap()).unwrap();
+    assert_eq!(result.messages_summarized, 2);
+    assert_eq!(result.messages.last().unwrap().turn_id.as_deref(), Some("tool-turn"));
+    assert!(matches!(
+        result.messages.last().unwrap().content[0],
+        ContentBlock::ToolResult { is_error: true, .. }
+    ));
+}
+
+#[test]
+fn rejects_lossy_and_incomplete_input() {
+    let mut req = request();
+    req.messages.push(Message::new(
+        Role::Assistant,
+        vec![ContentBlock::ProviderItem {
+            provider: "x".into(),
+            item: json!({}),
+        }],
+    ));
+    assert!(validate_history(&req.messages).is_err());
+    req.messages.pop();
+    req.messages.push(Message::new(
+        Role::User,
+        vec![ContentBlock::ToolResult {
+            tool_use_id: "orphan".into(),
+            content: "x".into(),
+            is_error: false,
+        }],
+    ));
+    assert!(validate_history(&req.messages).is_err());
+}
