+    assert_eq!(p.requests.lock().unwrap().len(), 3);
+    assert!(p.requests.lock().unwrap().iter().all(|r| !r.tools.is_empty()));
+}
+#[tokio::test]
+async fn unfinished_current_plan_gets_one_tool_enabled_retry_then_can_complete() {
+    let (mut engine, p) = engine(
+        vec![
+            plan("plan-1", "doing"),
+            answer("I will create files next"),
+            plan("plan-2", "done"),
+            answer("Completed and verified"),
+        ],
+        false,
+    );
+    let result = engine.run("Create files", "test").await.unwrap();
+    assert_eq!(result.stop_reason, StopReason::EndTurn);
+    let reqs = p.requests.lock().unwrap();
+    assert_eq!(reqs.len(), 4);
+    assert!(!reqs[2].tools.is_empty());
+    assert!(
+        serde_json::to_string(reqs[2].messages.last().unwrap())
+            .unwrap()
+            .contains("unfinished steps")
