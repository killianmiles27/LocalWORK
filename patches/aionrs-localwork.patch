@@ -0,0 +1,240 @@
+use super::*;
+use aion_types::llm::LlmEvent;
+use aion_types::message::{StopReason, TokenUsage};
+use std::sync::Mutex;
+use tokio::sync::mpsc;
+struct Provider {
+    prompts: Mutex<Vec<String>>,
+    truncate: bool,
+    reject_large: bool,
+    exact_tokens: Option<u64>,
+    pending: bool,
+    drop_request: bool,
+}
+#[async_trait::async_trait]
+impl LlmProvider for Provider {
+    async fn compact(
+        &self,
+        req: &NativeCompactRequest,
+    ) -> Result<Option<aion_types::compact::NativeCompactResult>, ProviderError> {
+        let tokens = self
+            .exact_tokens
+            .unwrap_or_else(|| estimate_messages_tokens(&req.messages));
+        let mut messages = req.messages.clone();
+        if self.drop_request {
+            messages.remove(0);
+        }
+
+        Ok(Some(aion_types::compact::NativeCompactResult {
+            messages,
+            compacted: false,
+            before_tokens: tokens,
+            after_tokens: tokens,
+            messages_summarized: 0,
+        }))
+    }
+    async fn stream(&self, req: &LlmRequest) -> Result<mpsc::Receiver<LlmEvent>, ProviderError> {
+        if self.pending {
+            return std::future::pending().await;
+        }
+        assert!(req.tools.is_empty());
+        assert!(matches!(req.thinking, Some(ThinkingConfig::Disabled)));
+        let text = serde_json::to_string(&req.messages).unwrap();
+        if self.reject_large && text.len() > 18000 {
+            return Err(ProviderError::PromptTooLong("test budget".into()));
+        }
+        self.prompts.lock().unwrap().push(text);
+        let (tx, rx) = mpsc::channel(2);
+        tx.send(LlmEvent::TextDelta(
+            "Verified workbook data; report still pending. Keep the source paths and original categories.".into(),
+        ))
+        .await
+        .unwrap();
+        tx.send(LlmEvent::Done {
+            stop_reason: if self.truncate {
+                StopReason::MaxTokens
+            } else {
+                StopReason::EndTurn
+            },
+            usage: TokenUsage::default(),
+        })
+        .await
+        .unwrap();
+        Ok(rx)
+    }
+}
+fn history() -> Vec<Message> {
+    let mut messages = vec![
+        Message::new(
+            Role::System,
+            vec![ContentBlock::Text {
+                text: "Preserve all files".into(),
+            }],
+        ),
+        Message::new(
+            Role::User,
+            vec![ContentBlock::Text {
+                text: "Make a yearly summary and one-page report".into(),
+            }],
+        ),
+    ];
+    for n in 0..6 {
+        messages.push(Message::new(
+            Role::Assistant,
+            vec![ContentBlock::ToolUse {
+                id: format!("call-{n}"),
+                name: "read".into(),
+                input: serde_json::json!({"path":"source.xlsx"}),
+                extra: None,
+            }],
+        ));
+        messages.push(Message::new(
+            Role::User,
+            vec![ContentBlock::ToolResult {
+                tool_use_id: format!("call-{n}"),
+                content: format!("fragment-{n}-{}-end-{n}", "\u{03b1}data ".repeat(3000)),
+                is_error: false,
+            }],
+        ));
+    }
+    messages
+}
+fn provider(truncate: bool) -> Provider {
+    Provider {
+        prompts: Mutex::new(vec![]),
+        truncate,
+        reject_large: false,
+        exact_tokens: None,
+        pending: false,
+        drop_request: false,
+    }
+}
+fn config() -> CompactConfig {
+    CompactConfig {
+        context_window: 32000,
+        output_reserve: 2000,
+        ..Default::default()
+    }
+}
+#[tokio::test]
+async fn first_turn_checkpoint_keeps_request_and_complete_recent_groups() {
+    let original = history();
+    let before = serde_json::to_value(&original).unwrap();
+    let p = provider(false);
+    let result = within_turn(&p, &original, "test", &config(), 100)
+        .await
+        .unwrap()
+        .unwrap();
+    assert!(result.compacted);
+    assert!(!result.native);
+    assert_eq!(
+        serde_json::to_value(&result.messages[..2]).unwrap(),
+        serde_json::to_value(&original[..2]).unwrap()
+    );
+    assert_eq!(
+        serde_json::to_value(&result.messages[result.messages.len() - 4..]).unwrap(),
+        serde_json::to_value(&original[original.len() - 4..]).unwrap()
+    );
+    assert_eq!(serde_json::to_value(&original).unwrap(), before);
+    let prompts = p.prompts.lock().unwrap().join("\n");
+    for n in 0..4 {
+        assert!(prompts.contains(&format!("fragment-{n}")));
+        assert!(prompts.contains(&format!("end-{n}")));
+    }
+    assert!(result.after_tokens.unwrap() < result.pre_compact_tokens);
+}
+#[tokio::test]
+async fn checkpoint_keeps_intervening_user_corrections_exact() {
+    let mut messages = history();
+    messages.insert(
+        6,
+        Message::new(
+            Role::User,
+            vec![ContentBlock::Text {
+                text: "Do not overwrite the source. Use euros.".into(),
+            }],
+        ),
+    );
+    let p = provider(false);
+    let result = within_turn(&p, &messages, "test", &config(), 0).await.unwrap().unwrap();
+    assert!(
+        result
+            .messages
+            .iter()
+            .any(|m| serde_json::to_value(m).unwrap() == serde_json::to_value(&messages[6]).unwrap())
+    );
+}
+#[tokio::test]
+async fn truncated_checkpoint_keeps_original() {
+    let messages = history();
+    let original = serde_json::to_value(&messages).unwrap();
+    assert!(matches!(
+        within_turn(&provider(true), &messages, "test", &config(), 0).await,
+        Err(CompactError::TruncatedResponse)
+    ));
+    assert_eq!(serde_json::to_value(messages).unwrap(), original);
+}
+#[tokio::test]
+async fn retry_shrinks_fragment_without_dropping_data() {
+    let mut p = provider(false);
+    p.reject_large = true;
+    let messages = history();
+    let result = within_turn(&p, &messages, "test", &config(), 0).await.unwrap().unwrap();
+    assert!(result.compacted);
+    let prompts = p.prompts.lock().unwrap().join("\n");
+    for n in 0..4 {
+        assert!(prompts.contains(&format!("fragment-{n}")));
+        assert!(prompts.contains(&format!("end-{n}")));
+    }
+}
+#[tokio::test]
+async fn unresolved_tool_call_is_never_checkpointed() {
+    let mut messages = history();
+    messages.pop();
+    assert!(
+        within_turn(&provider(false), &messages, "test", &config(), 0)
+            .await
+            .is_err()
+    );
+}
+
+#[tokio::test]
+async fn exact_token_validation_rejects_dense_tail_and_preserves_original() {
+    let messages = history();
+    let original = serde_json::to_value(&messages).unwrap();
+    let mut p = provider(false);
+    p.exact_tokens = Some(31900);
+    assert!(within_turn(&p, &messages, "test", &config(), 100).await.is_err());
+    assert_eq!(serde_json::to_value(&messages).unwrap(), original);
+}
+#[tokio::test]
+async fn emergency_reserve_is_checked_before_acceptance() {
+    let mut cfg = config();
+    cfg.emergency_buffer = 8000;
+    let mut p = provider(false);
+    p.exact_tokens = Some(25000);
+    assert!(within_turn(&p, &history(), "test", &cfg, 0).await.is_err());
+}
+#[tokio::test]
+async fn cancellation_during_checkpoint_keeps_original() {
+    let messages = history();
+    let original = serde_json::to_value(&messages).unwrap();
+    let mut p = provider(false);
+    p.pending = true;
+    assert!(
+        tokio::time::timeout(
+            std::time::Duration::from_millis(10),
+            within_turn(&p, &messages, "test", &config(), 0)
+        )
+        .await
+        .is_err()
+    );
+    assert_eq!(serde_json::to_value(&messages).unwrap(), original);
+}
+#[tokio::test]
+async fn native_revalidation_cannot_remove_protected_requests() {
+    let messages = history();
+    let mut p = provider(false);
+    p.drop_request = true;
+    assert!(within_turn(&p, &messages, "test", &config(), 0).await.is_err());
+}
