+                        text: format!("turn-{n}"),
+                    }],
+                )
+            })
+            .map(|mut message| {
+                message.turn_id = Some(format!("retained-{}", message.content.len()));
+                message
+            })
+            .collect()
+    }
+    #[tokio::test]
+    async fn native_canonical_tail_and_ids_survive_repeated_compaction() {
+        let provider = provider();
+        let original = history();
+        let mut state = CompactState::new();
+        let config = CompactConfig {
+            output_reserve: 500,
+            ..Default::default()
+        };
+        let first = autocompact_with_overhead(&provider, &original, "swift", &config, &mut state, 123)
+            .await
+            .unwrap();
+        assert!(first.compacted && first.native);
+        assert_eq!(first.messages.len(), 3);
+        assert_eq!(first.messages.last().unwrap().turn_id, original.last().unwrap().turn_id);
+        assert_eq!(first.pre_compact_tokens, 1123);
+        assert_eq!(provider.requests.lock().unwrap()[0].output_reserve, 623);
+        assert_eq!(
+            provider.requests.lock().unwrap()[0].messages[0].turn_id,
+            original[0].turn_id
+        );
+        let second = autocompact(&provider, &first.messages, "swift", &config, &mut state)
+            .await
