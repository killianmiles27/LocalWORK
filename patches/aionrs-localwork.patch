+            ..provider()
+        };
+        let original = history();
+        let mut state = CompactState::new();
+        let result = autocompact(&provider, &original, "swift", &CompactConfig::default(), &mut state)
+            .await
+            .unwrap();
+        assert!(!result.compacted);
+        assert_eq!(result.messages[0].turn_id, original[0].turn_id);
+    }
+    #[tokio::test]
+    async fn native_errors_and_cancel_leave_history_intact() {
+        let original = history();
+        let before = serde_json::to_value(&original).unwrap();
+        let mut state = CompactState::new();
+        let failing = NativeProvider {
+            fail: true,
+            ..provider()
+        };
+        assert!(
+            autocompact(&failing, &original, "swift", &CompactConfig::default(), &mut state)
+                .await
+                .is_err()
+        );
+        assert_eq!(state.consecutive_failures, 1);
+        let pending = NativeProvider {
+            pending: true,
+            ..provider()
+        };
+        let config = CompactConfig::default();
+        assert!(
+            tokio::time::timeout(
+                std::time::Duration::from_millis(10),
+                autocompact(&pending, &original, "swift", &config, &mut state)
+            )
+            .await
+            .is_err()
+        );
+        assert_eq!(serde_json::to_value(&original).unwrap(), before);
+        assert_eq!(
+            state.consecutive_failures, 1,
+            "cancelled request must not record a successful compaction"
+        );
+    }
