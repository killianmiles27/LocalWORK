+    #[tokio::test]
+    async fn completed_checkpoint_keeps_text_and_usage() {
+        let (tx, rx) = mpsc::channel(2);
+        tx.send(LlmEvent::TextDelta(
+            "<summary>Task constraints and next action</summary>".into(),
+        ))
+        .await
+        .unwrap();
+        tx.send(LlmEvent::Done {
+            stop_reason: StopReason::EndTurn,
+            usage: TokenUsage::default(),
+        })
+        .await
+        .unwrap();
+        let (text, _) = collect_stream_text(rx).await.unwrap();
+        assert!(text.contains("constraints and next action"));
