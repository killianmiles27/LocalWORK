diff --git a/crates/aion-agent/src/commands/compact_test.rs b/crates/aion-agent/src/commands/compact_test.rs
index b2679b4..17b6d20 100644
--- a/crates/aion-agent/src/commands/compact_test.rs
+++ b/crates/aion-agent/src/commands/compact_test.rs
@@ -162,4 +162,89 @@ mod tests {
         assert_eq!(ctx.context_state.compact_count, 1);
         assert_eq!(ctx.messages.len(), 2);
     }
+    struct NativeProvider {
+        compacted: bool,
+        fail: bool,
+    }
+    #[async_trait::async_trait]
+    impl LlmProvider for NativeProvider {
+        fn native_compaction_enabled(&self) -> bool {
+            true
+        }
+        async fn stream(&self, _: &LlmRequest) -> Result<mpsc::Receiver<LlmEvent>, ProviderError> {
+            panic!("manual native compaction must not call generic stream")
+        }
+        async fn compact(
+            &self,
+            request: &aion_types::compact::NativeCompactRequest,
+        ) -> Result<Option<aion_types::compact::NativeCompactResult>, ProviderError> {
+            if self.fail {
+                return Err(ProviderError::Parse("truncated response".into()));
+            }
+            let mut messages = request.messages.clone();
+            if self.compacted {
+                messages.remove(0);
+            }
+            Ok(Some(aion_types::compact::NativeCompactResult {
+                messages,
+                compacted: self.compacted,
+                before_tokens: 50000,
+                after_tokens: 1000,
+                messages_summarized: usize::from(self.compacted),
+            }))
+        }
+    }
+    #[tokio::test]
+    async fn manual_native_reuses_canonical_tail_and_noop_or_failure_retains_history() {
+        for (compacted, fail) in [(true, false), (false, false), (false, true)] {
+            let registry = CommandRegistry::new();
+            let output = NullSink;
+            let mut messages: Vec<Message> = (0..6)
+                .map(|index| {
+                    let mut message = Message::new(
+                        if index % 2 == 0 { Role::User } else { Role::Assistant },
+                        vec![ContentBlock::Text {
+                            text: format!("history-{index}"),
+                        }],
+                    );
+                    message.turn_id = Some(format!("turn-{index}"));
+                    message
+                })
+                .collect();
+            let original = serde_json::to_value(&messages).unwrap();
+            let tail = messages.last().unwrap().turn_id.clone();
+            let mut state = CompactState::new();
+            let mut context_state = ContextState::default();
+            let prompt_usage = PromptUsage::default();
+            let config = aion_config::compact::CompactConfig::default();
+            let mut ctx = CommandContext {
+                messages: &mut messages,
+                compact_state: &mut state,
+                compact_config: &config,
+                provider: Arc::new(NativeProvider { compacted, fail }),
+                model: "swift",
+                output: &output,
+                registry: &registry,
+                context_state: &mut context_state,
+                prompt_usage: &prompt_usage,
+                context_tools: &[],
+                dynamic_system_tokens: 0,
+            };
+            let result = CompactCommand.execute(&mut ctx, "").await.unwrap();
+            assert_eq!(ctx.messages.last().unwrap().turn_id, tail);
+            if compacted && !fail {
+                assert_eq!(result, CommandResult::ContextChanged);
+                assert_eq!(
+                    ctx.messages.len(),
+                    5,
+                    "must keep full canonical history instead of summary-only"
+                );
+                assert_eq!(ctx.context_state.compact_count, 1);
+            } else {
+                assert_eq!(result, CommandResult::Continue);
+                assert_eq!(ctx.context_state.compact_count, 0);
+                assert_eq!(serde_json::to_value(&ctx.messages).unwrap(), original);
+            }
+        }
+    }
 }
