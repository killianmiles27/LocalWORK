+    #[tokio::test]
+    async fn output_limit_does_not_accept_a_partial_checkpoint() {
+        let (tx, rx) = mpsc::channel(2);
+        tx.send(LlmEvent::TextDelta("<summary>missing unfinished work".into()))
+            .await
+            .unwrap();
+        tx.send(LlmEvent::Done {
+            stop_reason: StopReason::MaxTokens,
