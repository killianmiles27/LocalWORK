+//! Opt-in text compaction with a complete, validated replacement history.
+use std::collections::HashSet;
+use std::time::Duration;
+
+use aion_config::compat::{OpenAiApiMode, ProviderCompat};
+use aion_types::compact::{NativeCompactRequest, NativeCompactResult};
+use aion_types::message::{ContentBlock, Message, Role};
+use serde::Deserialize;
+use serde_json::{Value, json};
+
+use crate::error::ProviderError;
+use crate::openai_messages::build_messages;
+use crate::projector::ResolvedToolWireShape;
+use crate::transport::OpenAiTransport;
+
+#[derive(Deserialize)]
+struct WireResult {
+    messages: Vec<Value>,
+    compacted: bool,
+    before_tokens: u64,
+    after_tokens: u64,
+    retained_recent_count: usize,
+    summary: Option<String>,
+}
+
+fn invalid(reason: &str) -> ProviderError {
+    ProviderError::Parse(format!(
+        "Native compaction rejected: {reason}; original history preserved"
+    ))
+}
+
+pub(crate) async fn compact(
+    transport: &OpenAiTransport,
+    compat: &ProviderCompat,
+    path: &str,
+    request: &NativeCompactRequest,
+) -> Result<NativeCompactResult, ProviderError> {
+    // Only a relative API path is allowed. Never let a configuration path switch
+    // origins or smuggle query/fragment semantics into the authenticated request.
+    if !path.starts_with('/')
+        || path.starts_with("//")
+        || path.len() < 2
+        || path
+            .chars()
+            .any(|c| !(c.is_ascii_alphanumeric() || matches!(c, '/' | '-' | '_')))
+        || path[1..].split('/').any(str::is_empty)
+    {
+        return Err(invalid("invalid native_compaction_path"));
+    }
+    validate_history(&request.messages)?;
+    let mut projection = compat.clone();
+    projection.transport.openai_api_mode = Some(OpenAiApiMode::ChatCompletions);
+    projection.transport.api_path = Some(path.to_string());
+    // Native history is canonical. Do not clean, merge, or strip content while
+    // projecting it: boundaries must remain reversible to original messages.
+    projection.messages.merge_assistant_messages = Some(false);
+    projection.messages.clean_orphan_tool_results = Some(false);
+    projection.messages.dedup_tool_results = Some(false);
+    projection.messages.strip_patterns = None;
+    projection.tools.clean_orphan_tool_calls = Some(false);
+    projection.tools.sanitize_malformed_tool_calls = Some(false);
+    projection.tools.auto_tool_id = Some(false);
+    let (wire, boundaries) = project_history(&request.messages, &projection);
+    let body = json!({"model": request.model, "messages": wire,
+        "max_tokens": request.output_reserve, "if_needed": false});
+    if compat
+        .max_request_body_bytes()
+        .is_some_and(|limit| body.to_string().len() > limit)
+    {
+        return Err(invalid("request exceeds configured body limit"));
+    }
+    let http = transport.build_projected_request(body, &projection, ResolvedToolWireShape::OpenAiFunction)?;
+    let response = tokio::time::timeout(Duration::from_secs(600), async {
+        transport
+            .send(http)
+            .await?
+            .json::<WireResult>()
+            .await
+            .map_err(ProviderError::from)
+    })
+    .await
+    .map_err(|_| invalid("request timed out"))??;
+    validate_result(request, &wire, &boundaries, response)
+}
+
+fn project_history(messages: &[Message], compat: &ProviderCompat) -> (Vec<Value>, Vec<usize>) {
+    let mut wire = Vec::new();
+    let mut boundaries = vec![0];
+    for message in messages {
+        if message.role == Role::System {
+            let text = message
+                .content
+                .iter()
+                .filter_map(|block| match block {
+                    ContentBlock::Text { text } => Some(text.as_str()),
+                    _ => None,
+                })
+                .collect::<Vec<_>>()
+                .join("\n");
+            wire.push(json!({"role":"system", "content":text}));
+        } else {
+            wire.extend(build_messages(std::slice::from_ref(message), "", compat));
+        }
+        boundaries.push(wire.len());
+    }
+    (wire, boundaries)
+}
+
+fn validate_history(messages: &[Message]) -> Result<(), ProviderError> {
+    let mut pending = HashSet::new();
+    let mut seen = HashSet::new();
+    let mut past_system = false;
+    for message in messages {
+        if message.content.is_empty() {
+            return Err(invalid("empty message"));
+        }
+        if !pending.is_empty()
+            && !message
+                .content
+                .iter()
+                .all(|b| matches!(b, ContentBlock::ToolResult { .. }))
+        {
+            return Err(invalid("tool call interrupted before all results"));
+        }
+        if message.role == Role::System {
+            if past_system {
+                return Err(invalid("non-leading system history is unsupported"));
+            }
+        } else {
+            past_system = true;
+        }
+        let has_results = message
+            .content
+            .iter()
+            .any(|b| matches!(b, ContentBlock::ToolResult { .. }));
+        for block in &message.content {
+            match block {
+                ContentBlock::Text { .. } if message.role != Role::Tool && !has_results => {}
+                ContentBlock::Thinking { signature: None, .. } if message.role == Role::Assistant => {}
+                ContentBlock::ToolUse {
+                    id, name, extra: None, ..
+                } if message.role == Role::Assistant
+                    && !id.is_empty()
+                    && !name.is_empty()
+                    && seen.insert(id.clone()) =>
+                {
+                    pending.insert(id.clone());
+                }
+                ContentBlock::ToolResult { tool_use_id, .. }
+                    if matches!(message.role, Role::Tool | Role::User) && pending.remove(tool_use_id) => {}
+                _ => return Err(invalid("unsupported or lossy content, or malformed tool history")),
+            }
+        }
+        if !pending.is_empty() && !matches!(message.role, Role::Assistant | Role::Tool | Role::User) {
+            return Err(invalid("incomplete tool history"));
+        }
+    }
+    if !pending.is_empty() {
+        return Err(invalid("unresolved tool calls"));
+    }
+    Ok(())
+}
+
+fn validate_result(
+    request: &NativeCompactRequest,
+    original: &[Value],
+    boundaries: &[usize],
+    result: WireResult,
+) -> Result<NativeCompactResult, ProviderError> {
+    if !result.compacted {
+        if result.messages != original || result.before_tokens != result.after_tokens {
+            return Err(invalid("unchanged response modified history or token counts"));
+        }
+        return Ok(NativeCompactResult {
+            messages: request.messages.clone(),
+            compacted: false,
+            before_tokens: result.before_tokens,
+            after_tokens: result.after_tokens,
+            messages_summarized: 0,
+        });
+    }
+    if result.before_tokens == 0 || result.after_tokens == 0 || result.after_tokens >= result.before_tokens {
+        return Err(invalid("response did not reduce token usage"));
+    }
+    let pinned = request.messages.iter().take_while(|m| m.role == Role::System).count();
+    let keep = result.retained_recent_count;
+    let suffix_wire = original
+        .len()
+        .checked_sub(keep)
+        .ok_or_else(|| invalid("invalid retained count"))?;
+    let boundary = boundaries
+        .iter()
+        .position(|&n| n == suffix_wire)
+        .ok_or_else(|| invalid("retained suffix splits an original message"))?;
+    if boundary <= pinned || keep == 0 || result.messages.len() != pinned + 1 + keep {
+        return Err(invalid("invalid replacement shape"));
+    }
+    if result.messages[..pinned] != original[..pinned] || result.messages[pinned + 1..] != original[suffix_wire..] {
+        return Err(invalid("system instructions or retained history changed"));
+    }
+    let summary = &result.messages[pinned];
+    let text = summary
+        .get("content")
+        .and_then(Value::as_str)
+        .filter(|s| !s.trim().is_empty())
+        .ok_or_else(|| invalid("empty summary"))?;
+    if summary.get("role").and_then(Value::as_str) != Some("user")
+        || summary.as_object().is_none_or(|m| m.len() != 2)
+        || result
+            .summary
+            .as_deref()
+            .is_none_or(|s| s.trim().is_empty() || !text.ends_with(s))
+    {
+        return Err(invalid("summary must be plain user-level historical text"));
+    }
+    validate_history(&request.messages[boundary..])?;
+    let mut messages = request.messages[..pinned].to_vec();
+    messages.push(Message::new(
+        Role::User,
+        vec![ContentBlock::Text { text: text.to_string() }],
+    ));
+    // Restore originals instead of reconstructing tool metadata, turn IDs,
+    // timestamps and thinking blocks from a lossy wire representation.
+    messages.extend_from_slice(&request.messages[boundary..]);
+    tracing::debug!(
+        before_tokens = result.before_tokens,
+        after_tokens = result.after_tokens,
+        retained_messages = request.messages.len() - boundary,
+        "native compaction validated"
+    );
+    Ok(NativeCompactResult {
+        messages,
+        compacted: true,
+        before_tokens: result.before_tokens,
+        after_tokens: result.after_tokens,
+        messages_summarized: boundary - pinned,
+    })
+}
+
+#[cfg(test)]
+#[path = "native_compaction_test.rs"]
+mod native_compaction_test;
