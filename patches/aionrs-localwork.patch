+            micro_keep_recent: 1,
+            ..Default::default()
+        };
+        let mut state = CompactState::new();
+        state.last_input_tokens = 8000;
+        let mut messages = vec![Message::new(
+            Role::User,
+            vec![ContentBlock::Text {
+                text: "original task".into(),
+            }],
+        )];
+        for n in 0..8 {
+            messages.push(tool_use_msg(&format!("call-{n}"), "Read"));
+            messages.push(tool_result_msg(&format!("call-{n}"), "unmodified tool output"));
+        }
+        messages.last_mut().unwrap().turn_id = Some("retained-turn".into());
+        let mut engine = make_compact_engine(config, state, messages);
+        engine.max_tokens = Some(1000);
+        engine.context_state.replace_with_provider_usage(8000);
