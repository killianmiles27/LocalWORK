+
+/// Check a bounded recent suffix periodically, not on every token. Three copies
+/// of a long passage indicate stalled reasoning rather than a useful recap.
+#[derive(Default)]
+pub(crate) struct ReasoningRepetition {
+    checked_at: usize,
+}
+impl ReasoningRepetition {
+    pub(crate) fn observe(&mut self, text: &str) -> bool {
+        if text.len() < 8192 || text.len().saturating_sub(self.checked_at) < 512 {
+            return false;
+        }
+        self.checked_at = text.len();
+        let mut start = text.len().saturating_sub(1024);
+        while !text.is_char_boundary(start) {
+            start += 1;
+        }
+        let needle = &text[start..];
+        let mut from = start.saturating_sub(32768);
+        while !text.is_char_boundary(from) {
+            from += 1;
+        }
+        text[from..start].match_indices(needle).take(2).count() >= 2
+    }
+}
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn stops_long_repetition_but_not_unique_or_short_reasoning() {
+        let paragraph = "Plan the same formulas again without executing a tool. ".repeat(30);
+        let mut guard = ReasoningRepetition::default();
+        assert!(!guard.observe(&paragraph));
+        assert!(guard.observe(&paragraph.repeat(6)));
+        let unique = (0..3000)
+            .map(|n| format!("different evidence {n}; "))
+            .collect::<String>();
+        assert!(!ReasoningRepetition::default().observe(&unique));
+    }
+    #[test]
+    fn checks_utf8_boundaries_safely() {
+        assert!(ReasoningRepetition::default().observe(&"计算→résumé unique paragraph. ".repeat(500)));
+    }
 }
