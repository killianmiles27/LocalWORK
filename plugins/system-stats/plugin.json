{
  "id": "system-stats",
  "name": "System stats",
  "version": "1.0.0",
  "description": "CPU and GPU temperature and load, RAM and VRAM in the composer bar. Sensors this machine cannot read show a dash.",
  "contributes": {
    "statusItems": [
      { "id": "cpu",  "label": "CPU",  "source": "host:system_stats", "value": "cpu.load", "unit": "%", "secondary": "cpu.temp", "secondaryUnit": "°C", "warn": 85, "secondaryWarn": 85 },
      { "id": "ram",  "label": "RAM",  "source": "host:system_stats", "value": "ram.used_gib", "unit": " GB", "pct": "ram.pct", "warn": 90 },
      { "id": "gpu",  "label": "GPU",  "source": "host:system_stats", "value": "gpu.load", "unit": "%", "secondary": "gpu.temp", "secondaryUnit": "°C", "warn": 95, "secondaryWarn": 83 },
      { "id": "vram", "label": "VRAM", "source": "host:system_stats", "value": "gpu.vram_used_gib", "unit": " GB", "pct": "gpu.vram_pct", "warn": 95 }
    ]
  }
}
